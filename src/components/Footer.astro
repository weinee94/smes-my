---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale ?? config.site.lang;
---

<footer
  class:list={[
    "border-t border-slate-200 bg-white",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="app-layout grid gap-8 py-10 sm:grid-cols-[1fr_auto] sm:items-end">
    <div>
      <p class="font-semibold text-slate-950">SMEs.MY</p>
      <p class="mt-2 max-w-md text-sm leading-6 text-slate-500">
        关注马来西亚小生意的客户询问、团队责任与持续跟进。
      </p>
      <p class="mt-3 text-sm leading-6 text-slate-600">
        网站运营主体：WYNNE CONSULTANCY GROUP PLT<br />
        SSM 注册编号：202204002416 (LLP0032703-LGN)
      </p>
    </div>
    <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-500">
      <a href={getRelativeLocaleUrl(locale, "contact")}>联系</a>
      <a href="/privacy">隐私说明</a>
      <a href={getRelativeLocaleUrl(locale, "blog")}>人才观察</a>
      <span>© {currentYear}</span>
    </div>
  </div>
</footer>
