---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = { noMarginTop?: boolean } & HTMLAttributes<"footer">;
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale ?? config.site.lang;
---

<footer
  class:list={[
    "border-t border-slate-200 bg-white",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="app-layout grid gap-8 py-10 sm:grid-cols-[1fr_auto] sm:items-end">
    <div>
      <p class="font-semibold text-slate-950">SMEs.MY</p>
      <p class="mt-2 max-w-md text-sm leading-6 text-slate-500">
        马来西亚 SME 服务需求对接，以及可自行使用的工具与资源。
      </p>
    </div>
    <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-500">
      <a href={getRelativeLocaleUrl(locale, "request")}>找服务</a>
      <a href={getRelativeLocaleUrl(locale, "tools")}>工具与资源</a>
      <a href="/privacy">隐私说明</a>
      <a href={getRelativeLocaleUrl(locale, "posts")}>资料</a>
      <a href="mailto:weineetan@smes.com.my">Email</a>
      <span>© {currentYear}</span>
    </div>
  </div>
</footer>
