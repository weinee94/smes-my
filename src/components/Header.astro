---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconX from "@/assets/icons/IconX.svg";
import config from "@/config";
import { stripBase, stripLocale } from "@/utils/withBase";

const locale = Astro.currentLocale ?? config.site.lang;
const relativePath = stripBase(Astro.url.pathname);
const currentPath = stripLocale(relativePath.replace(/\/$/, "") || "/", locale);
const isActive = (path: string) =>
  currentPath === path || currentPath.startsWith(`${path}/`);
const nav = [
  { href: "follow-up-check", path: "/follow-up-check", label: "免费自查" },
  { href: "blog", path: "/blog", label: "人才观察" },
  { href: "weineetan", path: "/weineetan", label: "关于 Wei Nee" },
];
---

<a id="skip-to-content" href="#main-content" class="sr-only focus:not-sr-only"
  >跳到主要内容</a
>

<header
  class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl"
>
  <div class="app-layout flex h-18 items-center justify-between">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="flex items-center gap-2 font-semibold tracking-tight text-slate-950"
    >
      <img
        src="/assets/smes-site-icon.png"
        width="32"
        height="32"
        alt=""
        class="size-8 object-contain"
      />
      <span>SMEs.MY</span>
    </a>

    <button
      id="menu-btn"
      class="rounded-xl border border-slate-200 p-2 sm:hidden"
      aria-label="打开菜单"
      aria-expanded="false"
    >
      <IconMenuDeep id="menu-icon" class="size-5" />
      <IconX id="close-icon" class="hidden size-5" />
    </button>

    <nav id="nav-menu" class="hidden sm:block">
      <ul id="menu-items" class="items-center gap-1 sm:flex">
        {
          nav.map(item => (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, item.href)}
                class:list={[
                  "block rounded-xl px-3 py-2 text-sm font-medium transition hover:bg-slate-100",
                  isActive(item.path)
                    ? "bg-slate-100 text-slate-950"
                    : "text-slate-600",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="ml-2">
          <a
            href={getRelativeLocaleUrl(locale, "contact")}
            class="block rounded-xl bg-slate-950 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-700"
            >联系</a
          >
        </li>
      </ul>
    </nav>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-slate-200 bg-white px-5 py-3 sm:hidden"
  >
    <ul class="space-y-1">
      {
        nav.map(item => (
          <li>
            <a
              class="block rounded-xl px-3 py-2 text-sm"
              href={getRelativeLocaleUrl(locale, item.href)}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          class="block rounded-xl bg-slate-950 px-3 py-2 text-sm text-white"
          href={getRelativeLocaleUrl(locale, "contact")}>联系</a
        >
      </li>
    </ul>
  </nav>
</header>

<script>
  function setupMenu() {
    const button = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menu = document.querySelector("#mobile-menu");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");
    if (!button || !menu || !menuIcon || !closeIcon || button.dataset.ready)
      return;
    button.dataset.ready = "true";
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!open));
      menu.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }
  setupMenu();
  document.addEventListener("astro:after-swap", setupMenu);
</script>
