---
type Props = { compact?: boolean };
const { compact = false } = Astro.props;
---

<form
  class:list={["js-enquiry-form grid gap-4", compact ? "" : "sm:grid-cols-2"]}
  action="https://script.google.com/macros/s/AKfycbw66TcCNpD1fXsv0YRV5j9hhzS0LPNd8ojxogAmqQzYkZt0qZkvzOD9aygpl1-xUtkRcw/exec"
  method="post"
>
  <input type="hidden" name="form_type" value="quote_request" />
  <input
    type="hidden"
    name="_subject"
    value="New focused service request from SMEs.MY"
  />
  <input type="hidden" name="page_url" value="" />
  <input type="hidden" name="user_agent" value="" />
  <input type="hidden" name="lead_status" value="new" />
  <input type="hidden" name="consent_version" value="2026-09-16" />
  <label class="hidden" aria-hidden="true"
    >Website<input name="website" tabindex="-1" autocomplete="off" /></label
  >

  <label class="grid gap-2">
    <span class="text-sm font-semibold text-slate-800">需要什么服务？</span>
    <select
      name="service"
      required
      class="h-12 rounded-xl border border-slate-300 bg-white px-3 text-slate-950 outline-none focus:border-emerald-600"
    >
      <option value="">请选择</option>
      <option value="Accounting services">Accounting／Bookkeeping</option>
      <option value="Company secretary">Company Secretary</option>
      <option value="Not sure - accounting or company secretary"
        >不确定，需要先说明情况</option
      >
    </select>
  </label>

  <label class="grid gap-2">
    <span class="text-sm font-semibold text-slate-800">地点</span>
    <input
      name="location"
      maxlength="120"
      required
      placeholder="例如 Johor Bahru、KL、线上皆可"
      class="h-12 rounded-xl border border-slate-300 bg-white px-3 text-slate-950 outline-none placeholder:text-slate-400 focus:border-emerald-600"
    />
  </label>

  <label class="grid gap-2">
    <span class="text-sm font-semibold text-slate-800">Business type</span>
    <select
      name="business_type"
      class="h-12 rounded-xl border border-slate-300 bg-white px-3 text-slate-950 outline-none focus:border-emerald-600"
    >
      <option value="">如果知道，可以选择</option>
      <option value="Sdn. Bhd.">Sdn. Bhd.</option>
      <option value="Enterprise / Sole proprietor"
        >Enterprise／Sole proprietor</option
      >
      <option value="LLP / Partnership">LLP／Partnership</option>
      <option value="New business / Not registered">新业务／尚未注册</option>
      <option value="Not sure">不确定</option>
    </select>
  </label>

  <label class="grid gap-2">
    <span class="text-sm font-semibold text-slate-800">Email 或 WhatsApp</span>
    <input
      name="contact"
      maxlength="160"
      required
      placeholder="例如 name@example.com 或 +60123456789"
      class="h-12 rounded-xl border border-slate-300 bg-white px-3 text-slate-950 outline-none placeholder:text-slate-400 focus:border-emerald-600"
    />
  </label>

  <label class:list={["grid gap-2", compact ? "" : "sm:col-span-2"]}>
    <span class="text-sm font-semibold text-slate-800">简单说明需求</span>
    <textarea
      name="details"
      minlength="10"
      maxlength="3000"
      required
      rows="4"
      placeholder="请用至少 10 个字说明需求，暂不填写网址。例如：准备成立 Sdn. Bhd.，想了解秘书与年度费用。"
      class="rounded-xl border border-slate-300 bg-white p-3 text-slate-950 outline-none placeholder:text-slate-400 focus:border-emerald-600"
    ></textarea>
  </label>

  <label
    class:list={[
      "flex items-start gap-3 text-sm leading-6 text-slate-600",
      compact ? "" : "sm:col-span-2",
    ]}
  >
    <input
      type="checkbox"
      name="consent"
      value="yes"
      required
      class="mt-1 size-4 shrink-0 accent-emerald-700"
    />
    <span
      >我同意 SMEs.MY
      查看这项需求，并在适合时把我提交的资料分享给相关服务提供者。详见 <a
        class="font-semibold text-emerald-700 underline"
        href="/privacy">隐私说明</a
      >。</span
    >
  </label>

  <div class:list={[compact ? "" : "sm:col-span-2"]}>
    <button
      type="submit"
      class="w-full rounded-xl bg-emerald-600 px-5 py-3 font-semibold text-white transition hover:bg-emerald-700 disabled:cursor-wait disabled:opacity-60"
      >提交需求</button
    >
    <p
      class="form-status mt-3 min-h-6 text-sm text-slate-600"
      aria-live="polite"
    >
    </p>
  </div>
</form>

<script>
  import { confirmedLead } from "@/utils/lead-response";
  function setupEnquiryForms() {
    document
      .querySelectorAll<HTMLFormElement>(".js-enquiry-form")
      .forEach(form => {
        if (form.dataset.ready) return;
        form.dataset.ready = "true";
        form.querySelector<HTMLInputElement>('[name="page_url"]')!.value =
          window.location.origin + window.location.pathname;
        form.querySelector<HTMLInputElement>('[name="user_agent"]')!.value =
          navigator.userAgent;
        const params = new URLSearchParams(window.location.search);
        const services: Record<string, string> = {
          accounting: "Accounting services",
          "company-secretary": "Company secretary",
        };
        const selected = services[params.get("service") || ""];
        if (selected)
          form.querySelector<HTMLSelectElement>('[name="service"]')!.value =
            selected;
        const started = Date.now();
        let requestId: string = crypto.randomUUID();
        // Keep only the retry ID, never contact details or the free-text request.
        try {
          const pending = sessionStorage.getItem("smes-pending-lead");
          if (
            pending &&
            /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(
              pending
            )
          )
            requestId = pending;
        } catch {
          /* Storage may be disabled. */
        }

        form.addEventListener("submit", async event => {
          event.preventDefault();
          const button = form.querySelector<HTMLButtonElement>(
            'button[type="submit"]'
          );
          const status = form.querySelector<HTMLElement>(".form-status");
          if (!button || !status) return;
          button.disabled = true;
          status.textContent = "正在提交…";
          try {
            const data = new FormData(form);
            const fingerprintBytes = await crypto.subtle.digest(
              "SHA-256",
              new TextEncoder().encode(
                JSON.stringify(
                  [
                    "service",
                    "location",
                    "business_type",
                    "contact",
                    "details",
                  ].map(key => data.get(key))
                )
              )
            );
            const fingerprint = Array.from(
              new Uint8Array(fingerprintBytes),
              byte => byte.toString(16).padStart(2, "0")
            ).join("");
            try {
              const previous = sessionStorage.getItem(
                "smes-pending-fingerprint"
              );
              if (previous && previous !== fingerprint)
                requestId = crypto.randomUUID();
              sessionStorage.setItem("smes-pending-lead", requestId);
              sessionStorage.setItem("smes-pending-fingerprint", fingerprint);
            } catch {
              /* In-page retries still reuse the ID. */
            }
            let attribution: Record<string, string> = {};
            try {
              attribution = JSON.parse(
                sessionStorage.getItem("smes-lead-source") || "{}"
              );
            } catch {
              /* Optional. */
            }
            data.set("request_id", requestId);
            data.set("started_at", String(started));
            for (const key of [
              "source",
              "utm_source",
              "utm_medium",
              "utm_campaign",
            ])
              data.set(
                key,
                (
                  params.get(key) ||
                  attribution[key] ||
                  (key === "source"
                    ? location.pathname === "/"
                      ? "homepage-form"
                      : "request-form"
                    : "")
                ).slice(0, 120)
              );
            try {
              data.set(
                "referrer",
                attribution.referrer ||
                  (document.referrer ? new URL(document.referrer).origin : "")
              );
            } catch {
              /* Optional attribution. */
            }
            const response = await fetch(form.action, {
              method: "POST",
              body: data,
              signal: AbortSignal.timeout(25000),
            });
            if (!response.ok) throw new Error("Request failed");
            const leadId = confirmedLead(await response.json());
            form.reset();
            status.textContent = `需求已保存。编号：${leadId}。补充资料请注明编号，email weineetan@smes.com.my。`;
            try {
              sessionStorage.removeItem("smes-pending-lead");
              sessionStorage.removeItem("smes-pending-fingerprint");
              sessionStorage.setItem(
                "smes-lead-receipt",
                JSON.stringify({ id: leadId, at: Date.now() })
              );
              window.location.assign("/request/received");
            } catch {
              /* Inline receipt remains available when storage is blocked. */
            }
            requestId = crypto.randomUUID();
          } catch {
            status.innerHTML =
              '暂时无法确认提交结果，你填写的资料仍保留。可重试，或 email <a class="underline" href="mailto:weineetan@smes.com.my">weineetan@smes.com.my</a>，并注明参考编号 SME-' +
              requestId +
              "。";
          } finally {
            button.disabled = false;
          }
        });
      });
  }
  setupEnquiryForms();
  document.addEventListener("astro:after-swap", setupEnquiryForms);
</script>
