---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";

type Props = { variant?: "h2" | "h3" } & CollectionEntry<"posts">;
const { variant: Heading = "h2", id, data, filePath } = Astro.props;
---

<li
  class="group rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-lg hover:shadow-slate-200/60"
>
  <ul class="mb-5 flex flex-wrap gap-2" aria-label="主题">
    {
      data.tags.map(tag => (
        <li class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-800">
          {tag}
        </li>
      ))
    }
  </ul>
  <a href={getPostUrl(id, filePath, Astro.currentLocale)} class="block">
    <Heading
      transition:name={toTransitionName(id)}
      class="text-xl leading-snug font-semibold text-slate-950 group-hover:text-emerald-700"
      >{data.title}</Heading
    >
    <p class="mt-3 leading-7 text-slate-600">{data.description}</p>
    <span
      class="mt-6 inline-flex items-center text-sm font-semibold text-emerald-700"
      >阅读文章 <span
        aria-hidden="true"
        class="ml-1 transition group-hover:translate-x-1">→</span
      ></span
    >
  </a>
</li>
