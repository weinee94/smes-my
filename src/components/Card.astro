---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  showLane?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  showLane = true,
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, lane, ...props } = data;
---

<li class="record-card border-border border-t py-6 sm:py-7">
  <div class="mb-3 flex items-center justify-between gap-4">
    {showLane ? <p class="lane-label">{lane}</p> : <span />}
    <Datetime {...props} />
  </div>
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "group inline-block",
      "decoration-dashed underline-offset-4",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      class="editorial-title text-foreground group-hover:text-accent text-xl leading-8 font-semibold transition-colors sm:text-2xl"
      transition:name={toTransitionName(id)}
    >
      {title}
    </Heading>
  </a>
  <p class="text-muted-foreground mt-3 max-w-2xl leading-7">{description}</p>
</li>
