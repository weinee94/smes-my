---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  eventDate?: string | Date;
  eventPeriod?: string;
};

const {
  pubDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  eventDate,
  eventPeriod,
} = Astro.props;

const datetime = dayjs(eventDate ?? pubDatetime).tz(
  postTimezone ?? config.site.timezone
);

const date = eventPeriod ?? new Intl.DateTimeFormat(
  Astro.currentLocale === "zh-Hans" ? "zh-CN" : Astro.currentLocale,
  {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: postTimezone ?? config.site.timezone,
  }
).format(datetime.toDate());
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {
    <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>发生于</span>
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={eventDate ? datetime.toISOString() : undefined}
  >
    {date}
  </time>
</div>
