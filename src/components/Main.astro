---
type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
};
const { pageTitle, pageDesc, class: className } = Astro.props;
---

<main id="main-content" class:list={["app-layout py-12 sm:py-16", className]}>
  <div class="max-w-3xl">
    <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
      {pageTitle}
    </h1>
    {
      pageDesc && (
        <p class="mt-5 text-lg leading-8 text-slate-600">{pageDesc}</p>
      )
    }
  </div>
  <slot />
</main>
