---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="服务与交付 | SMEs.MY"
  description="为马来西亚小团队提供项目资料整理、tracker 与工作流程设计、轻量内部工具 prototype。"
>
  <Header />
  <main id="main-content">
    <section class="app-layout py-14 sm:py-20">
      <p class="text-sm font-semibold text-emerald-700">服务与交付</p>
      <h1
        class="mt-4 max-w-4xl text-4xl font-bold tracking-tight text-slate-950 sm:text-6xl"
      >
        为已经在运作的小团队，把一段混乱的工作整理清楚。
      </h1>
      <p class="mt-7 max-w-3xl text-lg leading-8 text-slate-600">
        SMEs.MY 面向仍以 WhatsApp、Excel
        和共享文件推进工作的马来西亚小团队。每个项目会先确认实际问题、使用者和交付物，再决定需要整理资料、重做
        tracker，还是建立一个轻量工具。
      </p>
    </section>

    <section class="border-y border-slate-200 bg-white">
      <div class="app-layout grid gap-6 py-14 lg:grid-cols-3">
        <article class="rounded-3xl bg-slate-50 p-7">
          <p class="text-sm font-semibold text-emerald-700">项目资料整理</p><h2
            class="mt-4 text-2xl font-semibold text-slate-950"
          >
            找出当前版本和缺口
          </h2><p class="mt-4 leading-7 text-slate-600">
            适合
            quotation、付款、图片、聊天确认和进度散在不同地方的项目。交付可以是一份
            current record、资料索引和后续更新规则。
          </p>
        </article>
        <article class="rounded-3xl bg-slate-50 p-7">
          <p class="text-sm font-semibold text-emerald-700">
            Tracker 与流程
          </p><h2 class="mt-4 text-2xl font-semibold text-slate-950">
            让 status 和下一步看得懂
          </h2><p class="mt-4 leading-7 text-slate-600">
            适合工作已经有人负责，但经常需要重新问进度的团队。会先保留目前真正使用的步骤，再整理
            owner、next step、waiting for 和 handover。
          </p>
        </article>
        <article class="rounded-3xl bg-slate-50 p-7">
          <p class="text-sm font-semibold text-emerald-700">轻量工具</p><h2
            class="mt-4 text-2xl font-semibold text-slate-950"
          >
            把重复工作先做成 prototype
          </h2><p class="mt-4 leading-7 text-slate-600">
            适合经常重复整理、复制或转发同类资料的情况。可以先做简单表单、生成器或内部页面，不急着开发完整软件。
          </p>
        </article>
      </div>
    </section>

    <section class="app-layout grid gap-10 py-16 lg:grid-cols-2 lg:py-22">
      <div>
        <p class="text-sm font-semibold text-emerald-700">怎样开始</p><h2
          class="mt-3 text-3xl font-bold text-slate-950"
        >
          先看实际资料，不从空白流程图开始。
        </h2>
      </div>
      <ol class="space-y-7">
        <li class="flex gap-4">
          <span
            class="grid size-9 shrink-0 place-items-center rounded-full bg-slate-950 text-sm font-semibold text-white"
            >1</span
          ><div>
            <h3 class="font-semibold text-slate-950">说明目前怎样做</h3><p
              class="mt-2 leading-7 text-slate-600"
            >
              可以直接用现有表格、截图或一段 WhatsApp
              说明，不需要先整理成正式文件。
            </p>
          </div>
        </li>
        <li class="flex gap-4">
          <span
            class="grid size-9 shrink-0 place-items-center rounded-full bg-slate-950 text-sm font-semibold text-white"
            >2</span
          ><div>
            <h3 class="font-semibold text-slate-950">确认一个明确范围</h3><p
              class="mt-2 leading-7 text-slate-600"
            >
              先选最影响工作的部分，讲清楚需要留下什么、由谁使用，以及什么算完成。
            </p>
          </div>
        </li>
        <li class="flex gap-4">
          <span
            class="grid size-9 shrink-0 place-items-center rounded-full bg-slate-950 text-sm font-semibold text-white"
            >3</span
          ><div>
            <h3 class="font-semibold text-slate-950">
              交付可以继续更新的版本
            </h3><p class="mt-2 leading-7 text-slate-600">
              文件、tracker
              或工具会连同使用方式一起交付，避免完成以后只有制作的人看得懂。
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section class="app-layout pb-16 sm:pb-22">
      <div
        class="rounded-[2rem] bg-emerald-600 p-8 text-white sm:flex sm:items-center sm:justify-between sm:p-10"
      >
        <div>
          <h2 class="text-2xl font-semibold">有一段工作一直整理不顺？</h2><p
            class="mt-2 text-emerald-50"
          >
            把目前的情况发过来，先确认适不适合处理。
          </p>
        </div><a
          class="mt-6 inline-flex rounded-2xl bg-white px-5 py-3 font-semibold text-emerald-800 sm:mt-0"
          href="mailto:weineetan@smes.com.my">Email SMEs.MY</a
        >
      </div>
    </section>
  </main>
  <Footer />
</Layout>
