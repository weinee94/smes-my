---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";

const cases = getSortedPosts(await getCollection("posts")).filter(post =>
  post.data.tags.includes("案例")
);
---

<Layout
  title="实战案例 | SMEs.MY"
  description="项目现场、系统整理与执行判断的实际片段。"
>
  <Header />
  <main id="main-content" class="app-layout py-14 sm:py-20">
    <p class="text-accent text-sm font-semibold">CASE STUDIES</p>
    <h1 class="editorial-title mt-2 text-4xl font-semibold sm:text-5xl">
      实战案例
    </h1>
    <p class="text-muted-foreground mt-5 max-w-2xl text-lg leading-8">
      项目里的几个实际片段：现场怎样卡住、记录怎样整理、下一步怎样排。
    </p>
    <ul class="mt-10 grid gap-x-12 sm:grid-cols-2">
      {cases.map(post => <Card {...post} />)}
    </ul>
  </main>
  <Footer />
</Layout>
