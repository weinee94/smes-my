---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";

const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
);
---

<Layout
  title="SME 观察 | SMEs.MY"
  description="Wei Nee 对马来西亚小团队人才管理问题的观察。"
>
  <Header />
  <main id="main-content">
    <section class="border-b border-slate-200 bg-white">
      <div class="app-layout py-14 sm:py-20">
        <p class="text-sm font-semibold text-emerald-700">SMEs.MY Blog</p>
        <h1
          class="mt-4 max-w-4xl text-4xl font-bold tracking-tight text-slate-950 sm:text-6xl"
        >
          小团队的人才与管理观察。
        </h1>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-slate-600">
          当团队变大，老板要决定哪些事该放手、哪些风险必须把关，以及谁适合带人。这里记录这些决定背后的管理问题。
        </p>
      </div>
    </section>

    <section class="app-layout py-14 sm:py-20">
      <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {posts.map(post => <Card {...post} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
