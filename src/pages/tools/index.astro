---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title="工具 | SMEs.MY" description="给小团队使用的免费轻量工具。">
  <Header />
  <main id="main-content" class="app-layout py-14 sm:py-20">
    <p class="text-sm font-semibold text-emerald-700">工具</p>
    <h1
      class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl"
    >
      可以直接使用的小工具
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
      先解决范围明确、经常重复的工作。工具不会要求注册，输入内容也不会传到服务器。
    </p>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <a
        href={getRelativeLocaleUrl(locale, "tools/project-brief")}
        class="group rounded-3xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-lg"
      >
        <span
          class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700"
          >FREE TOOL</span
        >
        <h2
          class="mt-5 text-2xl font-semibold text-slate-950 group-hover:text-emerald-700"
        >
          Project Brief Generator
        </h2>
        <p class="mt-3 leading-7 text-slate-600">
          把项目目标、已确认事项、还缺的资料和下一步整理成可以发送的 brief。
        </p>
        <span class="mt-7 inline-flex text-sm font-semibold text-emerald-700"
          >打开工具 →</span
        >
      </a>
      <div
        class="rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-7"
      >
        <span
          class="rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-600"
          >PLANNED</span
        >
        <h2 class="mt-5 text-2xl font-semibold text-slate-950">
          Project Status Setup
        </h2>
        <p class="mt-3 leading-7 text-slate-600">
          根据实际工作内容，整理一组够用的 status、owner、next step 和 waiting
          for。
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
