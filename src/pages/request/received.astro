---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="提交结果 | SMEs.MY" description="查看服务需求提交结果与下一步。">
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <Header />
  <main id="main-content" class="app-layout py-16">
    <section
      class="max-w-2xl rounded-3xl border border-slate-200 bg-white p-8 sm:p-10"
    >
      <h1 id="receipt-title" class="text-3xl font-bold">提交结果</h1>
      <p id="receipt-message" class="mt-5 leading-7 text-slate-600">
        此页面没有可确认的提交记录。如果尚未提交，请先填写服务需求表。
      </p>
      <p
        id="receipt-reference"
        class="mt-5 font-semibold break-all text-emerald-700"
        hidden
      >
      </p>
      <div id="receipt-next" hidden>
        <h2 class="mt-8 text-xl font-semibold">接下来会怎样？</h2>
        <p class="mt-3 leading-7 text-slate-600">
          SMEs.MY
          会查看类别、地点和需求范围；资料不足时会联系你补充。有适合的独立
          provider 才会介绍。提交不保证获得配对或报价，也不代表已委托任何服务。
        </p>
        <p class="mt-3 leading-7 text-slate-600">
          请保存需求编号。补充资料时可 email <a
            id="receipt-email"
            href="mailto:weineetan@smes.com.my"
            class="underline">weineetan@smes.com.my</a
          >，并注明编号，无需重复提交。
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-5">
        <a href="/tools" class="font-semibold text-emerald-700 underline"
          >使用工具与资源</a
        >
        <a href="/request" class="font-semibold text-slate-700 underline"
          >返回需求表</a
        >
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<script>
  function showReceipt() {
    try {
      const receipt = JSON.parse(
        sessionStorage.getItem("smes-lead-receipt") || "null"
      );
      if (
        !receipt ||
        !/^SME-[a-f0-9-]{36}$/i.test(receipt.id) ||
        Date.now() - receipt.at > 86400000
      )
        return;
      document.querySelector("#receipt-title")!.textContent = "需求已收到";
      document.querySelector("#receipt-message")!.textContent =
        "你的服务需求已经保存。";
      const reference =
        document.querySelector<HTMLElement>("#receipt-reference")!;
      reference.hidden = false;
      reference.textContent = `需求编号：${receipt.id}`;
      document.querySelector<HTMLElement>("#receipt-next")!.hidden = false;
      document.querySelector<HTMLAnchorElement>("#receipt-email")!.href =
        `mailto:weineetan@smes.com.my?subject=${encodeURIComponent(`Follow-up ${receipt.id}`)}`;
    } catch {
      /* Storage may be disabled. */
    }
  }
  showReceipt();
  document.addEventListener("astro:after-swap", showReceipt);
</script>
