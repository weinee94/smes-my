---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing about content");
const { Content } = await render(about);
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title="关于 | SMEs.MY"
  description="Wei Nee 的一些工作经历，以及为什么留下这些记录。"
>
  <Header />
  <main id="main-content" class="app-layout py-14 sm:py-20">
    <p class="text-accent text-sm font-semibold">ABOUT</p>
    <h1 class="editorial-title mt-3 text-4xl font-semibold sm:text-5xl">
      关于
    </h1>
    <article class="app-prose mt-10 max-w-3xl"><Content /></article>
    <p
      class="border-border text-muted-foreground mt-12 border-t pt-8 text-sm leading-7"
    >
      Wei Nee · Johor Bahru · <a
        class="text-accent underline underline-offset-4"
        href={getRelativeLocaleUrl(locale, "contact")}>联系</a
      >
    </p>
  </main>
  <Footer />
</Layout>
