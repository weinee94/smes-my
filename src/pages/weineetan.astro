---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing about content");
const { Content } = await render(about);
---

<Layout
  title="Wei Nee | SMEs.MY"
  description="Wei Nee — Commercial × Business Operations; Business Operator / System Builder。"
>
  <Header />
  <main id="main-content" class="app-layout py-14 sm:py-20">
    <p class="text-accent text-sm font-semibold">
      COMMERCIAL × BUSINESS OPERATIONS
    </p>
    <h1 class="editorial-title mt-2 text-4xl font-semibold sm:text-6xl">
      Wei Nee
    </h1>
    <p class="text-muted-foreground mt-5 max-w-2xl text-xl leading-8">
      Business Operator / System Builder
    </p>
    <article class="app-prose mt-12 max-w-3xl"><Content /></article>
    <section class="border-border mt-14 border-t pt-10">
      <p class="text-accent text-sm font-semibold">CONTACT</p>
      <h2 class="editorial-title mt-2 text-3xl font-semibold">Contact</h2>
      <p class="text-muted-foreground mt-4 leading-7">
        专业合作或工作机会，可电邮 <a
          class="text-accent underline underline-offset-4"
          href="mailto:hello@smes.com.my">hello@smes.com.my</a
        >。
      </p>
    </section>
  </main>
  <Footer />
</Layout>
