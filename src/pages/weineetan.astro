---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing about content");
const { Content } = await render(about);
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title="关于 | SMEs.MY"
  description="Wei Nee 的一些工作经历，以及为什么留下这些记录。"
>
  <Header />
  <main id="main-content" class="app-layout py-14 sm:py-20">
    <section class="grid gap-8 lg:grid-cols-[0.65fr_1.35fr] lg:gap-20">
      <div>
        <p class="eyebrow">WEI NEE</p>
        <h1 class="editorial-title mt-3 text-4xl font-semibold sm:text-5xl">
          关于
        </h1>
        <p class="text-muted-foreground mt-4 text-sm leading-7">
          Johor Bahru, Malaysia
        </p>
      </div>
      <p
        class="editorial-title max-w-3xl text-2xl leading-10 font-semibold sm:text-3xl sm:leading-[1.5]"
      >
        我的工作通常发生在部门交界：commercial activity
        已经开始，但资料、责任和下一步还没有完全对上。
      </p>
    </section>

    <article class="app-prose editorial-prose mt-14 max-w-3xl lg:ml-[34%]">
      <Content />
    </article>

    <div
      class="border-border mt-14 flex flex-wrap items-center justify-between gap-5 border-t pt-8 text-sm"
    >
      <span class="text-muted-foreground"
        >Wei Nee · Commercial / Business Operations</span
      >
      <a
        class="text-accent underline underline-offset-4"
        href={getRelativeLocaleUrl(locale, "contact")}>联系</a
      >
    </div>
  </main>
  <Footer />
</Layout>
