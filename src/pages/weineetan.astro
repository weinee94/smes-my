---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing about content");
const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | SMEs.MY`}
  description={about.data.description}
>
  <Header />
  <main id="main-content" class="app-layout py-14 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[.7fr_1.3fr]">
      <div>
        <p class="text-sm font-semibold text-emerald-700">关于</p><h1
          class="mt-3 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl"
        >
          {about.data.title}
        </h1><p class="mt-5 text-slate-500">Johor Bahru, Malaysia</p>
      </div>
      <article
        class="app-prose rounded-3xl border border-slate-200 bg-white p-7 shadow-sm sm:p-10"
      >
        <Content />
      </article>
    </div>
  </main>
  <Footer />
</Layout>
