---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";

const posts = getSortedPosts(await getCollection("posts"));
---

<Layout
  title="SMEs.MY｜让客户询问有人接、有人跟、有人负责"
  description="SMEs.MY 关注马来西亚小生意的市场营销与团队执行：从客户询问，到明确负责人、持续跟进。由 Wei Nee Tan 维护。"
>
  <Header />
  <main id="main-content">
    <section class="border-b border-slate-200 bg-white">
      <div
        class="app-layout grid gap-12 py-16 sm:py-24 lg:grid-cols-[1.25fr_.75fr] lg:items-center"
      >
        <div>
          <p
            class="text-sm font-semibold tracking-widest text-emerald-700 uppercase"
          >
            Talent × Market · Malaysia
          </p>
          <h1
            class="mt-5 max-w-4xl text-4xl font-bold tracking-tight text-slate-950 sm:text-6xl sm:leading-[1.08]"
          >
            客户有询问，团队却接不住？
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">
            营销把人带来，只是开始。谁回复、谁跟进、谁知道这笔生意走到哪里，决定机会会不会流失。SMEs.MY
            先聚焦这个小生意常见的断点。
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href="/contact"
              class="rounded-2xl bg-emerald-700 px-6 py-3 font-semibold text-white hover:bg-emerald-800"
              >说说你的跟进问题</a
            >
            <a
              href="/weineetan"
              class="rounded-2xl border border-slate-300 px-6 py-3 font-semibold text-slate-800 hover:border-emerald-700"
              >认识背后的人</a
            >
          </div>
          <p class="mt-5 text-sm leading-6 text-slate-500">
            目前在收集真实问题与首轮试点意向；没有现成团队或结果保证。
          </p>
        </div>
        <aside
          class="rounded-3xl border border-slate-200 bg-slate-50 p-7 sm:p-9"
        >
          <p class="text-sm font-semibold text-emerald-700">谁在做 SMEs.MY</p>
          <h2 class="mt-3 text-2xl font-bold text-slate-950">Wei Nee Tan</h2>
          <p class="mt-4 leading-7 text-slate-600">
            我在 Johor Bahru。曾做 BeforeTax 省税会计，面向个人与小生意的 tax
            accounting；也做过项目协调、网站和工作系统。现在把对小团队管理的观察，集中到获客之后的跟进执行。
          </p>
          <p class="mt-4 text-sm leading-6 text-slate-500">
            BeforeTax 是过往项目背景，不代表本站目前提供税务代理或会计服务。
          </p>
          <a
            href="/weineetan"
            class="mt-6 inline-block font-semibold text-emerald-700 underline"
            >了解经历与边界 →</a
          >
        </aside>
      </div>
    </section>

    <section class="app-layout py-16 sm:py-20">
      <p class="text-sm font-semibold text-emerald-700">先解决一个问题</p>
      <h2
        class="mt-3 max-w-3xl text-3xl font-bold tracking-tight text-slate-950"
      >
        让每条有价值的询问，都能走到明确的下一步。
      </h2>
      <div class="mt-9 grid gap-5 md:grid-cols-3">
        <article class="rounded-2xl border border-slate-200 p-6">
          <span class="text-sm font-bold text-emerald-700">01 · 市场</span><h3
            class="mt-3 text-xl font-semibold"
          >
            询问从哪里来
          </h3><p class="mt-3 leading-7 text-slate-600">
            先看现有渠道和客户常问的问题，知道哪类询问值得优先跟。
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 p-6">
          <span class="text-sm font-bold text-emerald-700">02 · 人才</span><h3
            class="mt-3 text-xl font-semibold"
          >
            谁有权负责
          </h3><p class="mt-3 leading-7 text-slate-600">
            把回复、判断和交接责任说清楚，减少所有决定都等老板批准。
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 p-6">
          <span class="text-sm font-bold text-emerald-700">03 · 跟进</span><h3
            class="mt-3 text-xl font-semibold"
          >
            下一步有没有发生
          </h3><p class="mt-3 leading-7 text-slate-600">
            用看得见的记录判断哪些机会在推进，哪些已经无人跟进。
          </p>
        </article>
      </div>
      <p class="mt-7 max-w-3xl leading-7 text-slate-600">
        这不是代投广告、代招聘或一套通用管理软件。首轮将从现有询问与团队交接方式着手，先确认问题是否值得做成可重复使用的方案。
      </p>
    </section>

    <section class="border-y border-slate-200 bg-slate-950 text-white">
      <div
        class="app-layout grid gap-8 py-14 lg:grid-cols-[1fr_auto] lg:items-center"
      >
        <div>
          <p class="text-sm font-semibold text-emerald-300">首轮问题收集</p><h2
            class="mt-3 text-3xl font-bold"
          >
            你的客户询问，通常卡在哪一步？
          </h2><p class="mt-4 max-w-2xl leading-7 text-slate-300">
            告诉我生意类型、询问来源、目前谁负责回复，以及最常漏掉的下一步。我会先判断是否属于这次聚焦的问题，再回复是否有合适的试点方式。
          </p>
        </div>
        <a
          href="/contact"
          class="inline-flex rounded-2xl bg-white px-6 py-3 font-semibold text-slate-950 hover:bg-emerald-100"
          >说明目前情况 →</a
        >
      </div>
    </section>

    <section class="app-layout py-16 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-emerald-700">人才观察</p><h2
            class="mt-3 text-3xl font-bold text-slate-950"
          >
            从团队真实的工作方式开始。
          </h2>
        </div><a href="/blog" class="font-semibold text-emerald-700 underline"
          >阅读全部 →</a>
      </div>
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {posts.slice(0, 3).map(post => <Card variant="h3" {...post} />)}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
