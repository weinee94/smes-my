---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const cases = posts.filter(post => post.data.tags.includes("案例"));
const notes = posts.filter(post => post.data.tags.includes("工作笔记"));
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-border border-b py-14 sm:py-20">
      <p class="text-accent text-sm font-semibold tracking-[0.14em] uppercase">
        SMEs.MY
      </p>
      <h1
        class="editorial-title mt-4 max-w-3xl text-4xl leading-[1.2] font-semibold sm:text-5xl"
      >
        把乱的东西整理清楚，让事情继续走。
      </h1>
      <p class="text-muted-foreground mt-6 max-w-2xl text-lg leading-8">
        写的都是真实发生过的事：event confirmed 以后，数字还要怎样分；creator
        到酒店以前，哪些事情要先对上；几个工互相等的时候，谁不能再等；一个网站做得出来，却决定不做。
      </p>
    </section>

    <section class="border-border border-b py-14 sm:py-20">
      <div class="mb-7 flex items-end justify-between gap-4">
        <div>
          <p class="text-accent text-sm font-semibold">NOTES</p><h2
            class="editorial-title mt-2 text-3xl font-semibold"
          >
            经营笔记
          </h2>
        </div>
        <a
          class="text-sm underline underline-offset-4"
          href={getRelativeLocaleUrl(locale, "posts")}>全部笔记</a
        >
      </div>
      <ul class="grid gap-x-10 sm:grid-cols-2">
        {notes.slice(0, 4).map(post => <Card variant="h3" {...post} />)}
      </ul>
    </section>

    <section class="border-border border-b py-14 sm:py-20">
      <div class="mb-7 flex items-end justify-between gap-4">
        <div>
          <p class="text-accent text-sm font-semibold">CASES</p><h2
            class="editorial-title mt-2 text-3xl font-semibold"
          >
            实战案例
          </h2>
        </div>
        <a
          class="text-sm underline underline-offset-4"
          href={getRelativeLocaleUrl(locale, "cases")}>查看案例</a
        >
      </div>
      <ul class="grid gap-x-10 sm:grid-cols-2">
        {cases.slice(0, 4).map(post => <Card variant="h3" {...post} />)}
      </ul>
    </section>

    <section
      class="grid gap-8 py-12 sm:grid-cols-[1fr_auto] sm:items-end sm:py-16"
    >
      <div>
        <p class="text-accent text-sm font-semibold">ABOUT</p>
        <p
          class="editorial-title mt-3 max-w-2xl text-2xl leading-9 font-semibold"
        >
          我是 Wei Nee。在 Johor Bahru 工作。这里留下的是
          event、campaign、项目、客户和 vendor 之间，真的发生过的工作记录。
        </p>
      </div>
      <div class="flex gap-5 text-sm">
        <a
          class="underline underline-offset-4"
          href={getRelativeLocaleUrl(locale, "weineetan")}>关于</a
        >
        <a
          class="underline underline-offset-4"
          href={getRelativeLocaleUrl(locale, "contact")}>联系</a
        >
      </div>
    </section>
  </main>
  <Footer />
</Layout>
