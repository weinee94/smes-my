---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const featuredSlugs = [
  "case-hosted-stay-needs-operations",
  "note-task-is-waiting-for-whom",
  "note-confirmed-is-not-final-revenue",
];
const featured = featuredSlugs
  .map(slug => posts.find(post => post.id === slug))
  .filter(post => post !== undefined);
const latest = posts.filter(post => !featured.includes(post)).slice(0, 5);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="py-16 sm:py-24">
      <div>
        <p class="eyebrow">商业现场 · 系统 · 判断</p>
        <h1
          class="editorial-title mt-5 max-w-4xl text-4xl leading-[1.18] font-semibold sm:text-6xl"
        >
          商业现场很少按部门分开。
        </h1>
        <p
          class="text-muted-foreground mt-7 max-w-2xl text-lg leading-8 sm:text-xl sm:leading-9"
        >
          一个 enquiry 怎样进入 pipeline，event confirmed 后数字怎样分，creator
          到场前谁要接手，系统里还有哪件事在等人。这里记录这些实际发生的工作。
        </p>
      </div>
    </section>

    <section class="border-border border-t py-14 sm:py-20">
      <div class="mb-10 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <p class="eyebrow">SELECTED RECORDS</p>
          <h2 class="editorial-title mt-3 text-3xl font-semibold sm:text-4xl">
            三个正在发生的工作问题
          </h2>
        </div>
        <a
          class="text-sm underline underline-offset-4"
          href={getRelativeLocaleUrl(locale, "posts")}
        >
          查看全部记录
        </a>
      </div>

      <ol class="border-border grid border-b lg:grid-cols-3">
        {
          featured.map((post, index) => (
            <li class="border-border border-t py-7 lg:border-r lg:px-7 lg:first:pl-0 lg:last:border-r-0 lg:last:pr-0">
              <div class="mb-8 flex items-center justify-between">
                <span class="lane-label">{post.data.lane}</span>
                <span class="text-muted-foreground text-xs">0{index + 1}</span>
              </div>
              <a
                class="group block"
                href={getPostUrl(post.id, post.filePath, locale)}
              >
                <h3 class="editorial-title group-hover:text-accent text-2xl leading-9 font-semibold transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-muted-foreground mt-4 leading-7">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="border-border grid gap-12 border-b py-14 sm:py-20 lg:grid-cols-[0.55fr_1.45fr] lg:gap-20"
    >
      <div>
        <p class="eyebrow">THE THREAD</p>
        <h2 class="editorial-title mt-3 text-3xl leading-tight font-semibold">
          事情怎样从发生，走到可以处理。
        </h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-3">
        <div>
          <p class="lane-label">现场</p>
          <p class="mt-3 leading-7">
            先交代事情在哪里发生、牵涉谁，以及当时有哪些限制。
          </p>
        </div>
        <div>
          <p class="lane-label">系统</p>
          <p class="mt-3 leading-7">
            记录资料怎样进入同一个结构，owner、状态和下一步怎样看得见。
          </p>
        </div>
        <div>
          <p class="lane-label">判断</p>
          <p class="mt-3 leading-7">
            只留下真正做过的取舍：先追什么、分开什么，以及哪些数字还不能下结论。
          </p>
        </div>
      </div>
    </section>

    <section class="py-14 sm:py-20">
      <div class="mb-6">
        <p class="eyebrow">RECENT</p>
        <h2 class="editorial-title mt-3 text-3xl font-semibold">最近记录</h2>
      </div>
      <ul>{latest.map(post => <Card variant="h3" {...post} />)}</ul>
    </section>

    <section
      class="border-border grid gap-8 border-t py-12 sm:grid-cols-[1fr_auto] sm:items-end sm:py-16"
    >
      <div>
        <p class="eyebrow">WEI NEE</p>
        <p
          class="editorial-title mt-3 max-w-2xl text-2xl leading-9 font-semibold"
        >
          这些记录来自我做过的 commercial、project coordination 和 system work。
        </p>
      </div>
      <div class="flex gap-5 text-sm">
        <a
          class="underline underline-offset-4"
          href={getRelativeLocaleUrl(locale, "weineetan")}>查看经历</a
        >
        <a
          class="underline underline-offset-4"
          href={getRelativeLocaleUrl(locale, "contact")}>联系</a
        >
      </div>
    </section>
  </main>
  <Footer />
</Layout>
