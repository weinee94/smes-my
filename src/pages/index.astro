---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import EnquiryForm from "@/components/EnquiryForm.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(
  await getCollection("posts", ({ data }) => !data.draft)
);
---

<Layout
  title="SMEs.MY｜Accounting 与 Company Secretary 服务需求"
  description="提交 accounting、bookkeeping 或 company secretary 服务需求。SMEs.MY 会先核对资料，有适合 provider 时再作介绍。"
>
  <Header />
  <main id="main-content">
    <section
      class="relative overflow-hidden border-b border-slate-200 bg-white"
    >
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_86%_12%,rgba(242,193,78,0.26),transparent_28%),radial-gradient(circle_at_8%_90%,rgba(39,111,191,0.10),transparent_26%)]"
      >
      </div>
      <div
        class="app-layout relative grid gap-12 py-16 sm:py-22 lg:grid-cols-[1fr_.9fr] lg:items-center"
      >
        <div>
          <p
            class="text-sm font-semibold tracking-[0.14em] text-emerald-700 uppercase"
          >
            Malaysia business service enquiries
          </p>
          <h1
            class="mt-5 max-w-3xl text-4xl font-bold tracking-[-0.04em] text-slate-950 sm:text-6xl sm:leading-[1.06]"
          >
            找 accountant 或 company secretary，不必先一家一家问。
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">
            告诉 SMEs.MY 你的 business
            type、地点和目前需要处理的事情。我们会先核对需求，有适合的独立服务提供者时才作介绍。
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a
              class="rounded-2xl bg-emerald-600 px-5 py-3 font-semibold text-white transition hover:bg-emerald-700"
              href="/request?source=home-hero">找服务：免费提交需求</a
            >
            <a
              class="rounded-2xl border border-slate-300 bg-white px-5 py-3 font-semibold text-slate-800 transition hover:border-emerald-600"
              href={getRelativeLocaleUrl(locale, "tools")}
              >自己解决：工具与资源</a
            >
          </div>
          <p class="mt-5 text-sm text-slate-500">
            目前只开放 Accounting／Bookkeeping 与 Company
            Secretary。提交不保证一定获得报价。
          </p>
        </div>

        <div
          class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-2xl shadow-slate-300/50 sm:p-8"
        >
          <div class="mb-6">
            <p class="text-sm font-semibold text-emerald-700">提交一项需求</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-950">
              先说明情况，再决定要找谁。
            </h2>
          </div>
          <EnquiryForm compact />
        </div>
      </div>
    </section>

    <section class="app-layout py-16 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr]">
        <div>
          <p class="text-sm font-semibold text-emerald-700">目前接受的需求</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
            先做两个明确类别。
          </h2>
          <p class="mt-4 leading-7 text-slate-600">
            SMEs.MY 目前不是完整 directory，也不会列出未经核对的大量
            provider。先把需求收集和介绍这一步做好。
          </p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <article class="rounded-3xl border border-slate-200 bg-white p-7">
            <p class="text-sm font-semibold text-emerald-700">
              Accounting／Bookkeeping
            </p>
            <h3 class="mt-4 text-xl font-semibold text-slate-950">
              账目需要开始、整理或换人接手
            </h3>
            <p class="mt-3 leading-7 text-slate-600">
              适合需要 bookkeeping、management accounts、year-end account
              preparation，或暂时不确定该找 accountant 还是 tax agent 的企业。
            </p>
            <a
              class="mt-5 inline-block font-semibold text-emerald-700 underline"
              href="/request?service=accounting&source=home-category"
              >提交 Accounting 需求 →</a
            >
          </article>
          <article class="rounded-3xl border border-slate-200 bg-white p-7">
            <p class="text-sm font-semibold text-emerald-700">
              Company Secretary
            </p>
            <h3 class="mt-4 text-xl font-semibold text-slate-950">
              成立公司、年度事项或更换秘书
            </h3>
            <p class="mt-3 leading-7 text-slate-600">
              适合准备成立 Sdn. Bhd.、想了解年度费用，或需要处理现有 company
              secretary 服务安排的企业。
            </p>
            <a
              class="mt-5 inline-block font-semibold text-emerald-700 underline"
              href="/request?service=company-secretary&source=home-category"
              >提交 Company Secretary 需求 →</a
            >
          </article>
        </div>
      </div>
    </section>

    <section class="border-y border-slate-200 bg-slate-950 text-white">
      <div class="app-layout grid gap-10 py-16 lg:grid-cols-[.72fr_1.28fr]">
        <div>
          <p class="text-sm font-semibold text-emerald-300">怎样运作</p>
          <h2 class="mt-3 text-3xl font-bold">
            不是自动把你的号码发给一堆人。
          </h2>
        </div>
        <ol class="grid gap-4 sm:grid-cols-3">
          <li class="rounded-2xl border border-slate-800 p-5">
            <span class="text-sm font-semibold text-emerald-300">01</span><h3
              class="mt-3 font-semibold"
            >
              提交需求
            </h3><p class="mt-2 text-sm leading-6 text-slate-400">
              说明服务类别、地点、business type 和目前情况。
            </p>
          </li>
          <li class="rounded-2xl border border-slate-800 p-5">
            <span class="text-sm font-semibold text-emerald-300">02</span><h3
              class="mt-3 font-semibold"
            >
              先核对范围
            </h3><p class="mt-2 text-sm leading-6 text-slate-400">
              资料不足时，SMEs.MY 才会联系你补充。
            </p>
          </li>
          <li class="rounded-2xl border border-slate-800 p-5">
            <span class="text-sm font-semibold text-emerald-300">03</span><h3
              class="mt-3 font-semibold"
            >
              适合才介绍
            </h3><p class="mt-2 text-sm leading-6 text-slate-400">
              是否接受服务与报价，仍由你和 provider 自己决定。
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section class="app-layout py-16 sm:py-20">
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class="text-sm font-semibold text-emerald-700">SME 观察</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">
            把中小型企业里经常发生的问题写清楚。
          </h2>
        </div>
        <a
          class="text-sm font-semibold text-emerald-700"
          href={getRelativeLocaleUrl(locale, "blog")}>阅读博客 →</a
        >
      </div>
      <ul class="mt-9 grid gap-5 md:grid-cols-3">
        {posts.slice(0, 3).map(post => <Card variant="h3" {...post} />)}
      </ul>
    </section>

    <section class="app-layout pb-16 sm:pb-20">
      <div
        class="rounded-[2rem] border border-slate-200 bg-white p-8 sm:flex sm:items-center sm:justify-between"
      >
        <div>
          <p class="text-sm font-semibold text-emerald-700">
            For service providers
          </p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-950">
            提供 accounting 或 company secretary 服务？
          </h2>
          <p class="mt-2 text-slate-600">
            欢迎说明服务范围、地点、客户类型和合作方式。所有合作会先核对，不自动刊登。
          </p>
        </div>
        <a
          class="mt-6 inline-flex rounded-2xl bg-slate-950 px-5 py-3 font-semibold text-white sm:mt-0"
          href="mailto:weineetan@smes.com.my?subject=Provider%20partnership%20with%20SMEs.MY"
          >联系 SMEs.MY</a
        >
      </div>
    </section>
  </main>
  <Footer />
</Layout>
