---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="border-border border-b py-14 sm:py-20">
      <h1 class="editorial-title text-3xl font-semibold sm:text-4xl">SMEs.MY</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8">我把一些实际做过的工作和项目记录留在这里。</p>
      <p class="text-muted-foreground mt-3 max-w-2xl leading-8">
        有酒店里的事情、装修项目，也有自己做网站和其他小实验时遇到的东西。有些当时就有答案，有些后来才补上。
      </p>
      <a class="mt-6 inline-block text-sm underline underline-offset-4" href={getRelativeLocaleUrl(locale, "posts")}>看全部记录</a>
    </section>

    <section class="border-border border-b py-12 sm:py-16" aria-labelledby="recent-records">
      <h2 id="recent-records" class="editorial-title text-2xl font-semibold">最近的记录</h2>
      <ul class="mt-5">
        {posts.slice(0, 6).map(post => <Card variant="h3" {...post} />)}
      </ul>
    </section>

    <section class="py-12 sm:py-16" aria-labelledby="about-site">
      <h2 id="about-site" class="editorial-title text-2xl font-semibold">关于这个网站</h2>
      <p class="text-muted-foreground mt-4 max-w-2xl leading-8">
        SMEs.MY 最初只是想把我真正做过的事情留下来。有些事情当时没觉得特别，后来有值得补的，就继续补。
      </p>
      <a class="mt-5 inline-block text-sm underline underline-offset-4" href={getRelativeLocaleUrl(locale, "weineetan")}>关于 Wei Nee</a>
    </section>
  </main>
  <Footer />
</Layout>
